<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RizzServer.Sdk</AssemblyName>
    <RootNamespace>RizzServer.Sdk</RootNamespace>

    <!-- dotnet pack RizzServer.Sdk -c Release  ->  a NuGet package plugin projects reference -->
    <PackageId>RizzServer.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Description>Write your own RizzServer driver: implement IDriverPlugin, drop the build output into the plugins folder.</Description>
    <Authors>RizzDaddySolutions</Authors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
  </ItemGroup>

</Project>
