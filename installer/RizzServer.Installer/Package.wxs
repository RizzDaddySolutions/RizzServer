<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RizzServer"
           Manufacturer="RizzDaddy Solutions"
           Version="$(ProductVersion)"
           UpgradeCode="f0e7f136-99af-4d50-a18d-033fad94a292"
           Scope="perMachine"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of RizzServer is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPCOMMENTS" Value="OPC UA gateway for Modbus, RS-232, MQTT, OPC DA and OPC UA sources" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RizzServer" />
    </StandardDirectory>

    <!-- Everything except the exe, which carries the Start menu shortcut below. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\RizzServer.exe" />
        <Exclude Files="$(PublishDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <ComponentGroup Id="MainExecutable" Directory="INSTALLFOLDER">
      <Component Id="RizzServerExe">
        <File Id="RizzServerExe" Source="$(PublishDir)\RizzServer.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start menu shortcut: own component with an HKCU key path (ICE43/ICE57). -->
    <ComponentGroup Id="Shortcuts" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcutComponent">
        <Shortcut Id="StartMenuShortcut" Name="RizzServer" Description="OPC UA gateway"
                  Target="[INSTALLFOLDER]RizzServer.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\RizzDaddy Solutions\RizzServer" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="RizzServer" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="MainExecutable" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
