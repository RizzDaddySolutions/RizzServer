<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RizzServer.App.App">
  <!-- RequestedThemeVariant is set from the saved View ▸ Theme choice at startup (System / Light / Dark). -->

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="ChromeBrush" Color="#F0F2F5" />
          <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HeaderBrush" Color="#DCE6F2" />
          <SolidColorBrush x:Key="SectionTextBrush" Color="#1F3A5F" />
          <SolidColorBrush x:Key="LineBrush" Color="#C9D2DC" />
          <SolidColorBrush x:Key="GridLineBrush" Color="#E3E8EE" />
          <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#EEF2F7" />
          <SolidColorBrush x:Key="PropLabelBrush" Color="#F6F8FA" />
          <SolidColorBrush x:Key="MutedBrush" Color="#5B6670" />
          <SolidColorBrush x:Key="CardBrush" Color="#F6F8FA" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#C9D2DC" />
          <SolidColorBrush x:Key="ToolIconBrush" Color="#33557F" />
          <SolidColorBrush x:Key="ToolHoverBrush" Color="#E1EAF5" />
          <SolidColorBrush x:Key="ToolHoverBorderBrush" Color="#9DB8DB" />
          <SolidColorBrush x:Key="TreeIconFillBrush" Color="#B7C7DD" />
          <SolidColorBrush x:Key="TreeIconStrokeBrush" Color="#33557F" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="ChromeBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="PanelBrush" Color="#1F1F1F" />
          <SolidColorBrush x:Key="HeaderBrush" Color="#333333" />
          <SolidColorBrush x:Key="SectionTextBrush" Color="#D6E6F5" />
          <SolidColorBrush x:Key="LineBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="GridLineBrush" Color="#2E2E2E" />
          <SolidColorBrush x:Key="ColumnHeaderBrush" Color="#333333" />
          <SolidColorBrush x:Key="PropLabelBrush" Color="#262626" />
          <SolidColorBrush x:Key="MutedBrush" Color="#9AA5AE" />
          <SolidColorBrush x:Key="CardBrush" Color="#262626" />
          <SolidColorBrush x:Key="CardBorderBrush" Color="#3A3A3A" />
          <SolidColorBrush x:Key="ToolIconBrush" Color="#7FB6EA" />
          <SolidColorBrush x:Key="ToolHoverBrush" Color="#3A4654" />
          <SolidColorBrush x:Key="ToolHoverBorderBrush" Color="#4A6A8A" />
          <SolidColorBrush x:Key="TreeIconFillBrush" Color="#3B5675" />
          <SolidColorBrush x:Key="TreeIconStrokeBrush" Color="#7FB6EA" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- The RizzDaddy blue (same as RizzExplorer): accent #0078D4, selection #115990 -->
      <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
      <SolidColorBrush x:Key="RizzSelection" Color="#115990" />
      <SolidColorBrush x:Key="RizzSelectionHover" Color="#1A6BAE" />

      <SolidColorBrush x:Key="ListBoxItemBackgroundSelected" Color="#115990" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPointerOver" Color="#1A6BAE" />
      <SolidColorBrush x:Key="ListBoxItemBackgroundSelectedPressed" Color="#0E4B7B" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#115990" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#1A6BAE" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#0E4B7B" />
      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#115990" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#1A6BAE" />
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#115990" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#1A6BAE" />

      <StreamGeometry x:Key="PlayIcon">M3,2 L13,8 L3,14 Z</StreamGeometry>
      <StreamGeometry x:Key="StopIcon">M3,3 H13 V13 H3 Z</StreamGeometry>
      <StreamGeometry x:Key="PlusIcon">M7,2 H9 V7 H14 V9 H9 V14 H7 V9 H2 V7 H7 Z</StreamGeometry>
      <StreamGeometry x:Key="CrossIcon">M3,4 L4,3 L8,7 L12,3 L13,4 L9,8 L13,12 L12,13 L8,9 L4,13 L3,12 L7,8 Z</StreamGeometry>
      <StreamGeometry x:Key="SaveIcon">M2,2 H11 L14,5 V14 H2 Z M5,2 V6 H10 V2 Z M4,9 H12 V14 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="FolderIcon">M1,3 H6 L8,5 H15 V13 H1 Z</StreamGeometry>
      <StreamGeometry x:Key="ServerIcon">M2,2 H14 V6 H2 Z M2,8 H14 V12 H2 Z M4,3.5 H6 V4.5 H4 Z M4,9.5 H6 V10.5 H4 Z</StreamGeometry>
      <StreamGeometry x:Key="TableIcon">M1,2 H15 V14 H1 Z M1,6 H15 M6,2 V14</StreamGeometry>
      <StreamGeometry x:Key="ProjectIcon">M2,1 H10 L13,4 V15 H2 Z M10,1 V4 H13</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0078D4" />
        <ColorPaletteResources x:Key="Dark" Accent="#0078D4" RegionColor="#1F1F1F" ErrorText="#FF6B6B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Selected rows are always the deep blue, so their text is always white (both themes) -->
    <Style Selector="DataGridRow:selected"><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter"><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="White" /></Style>

    <!-- Text + card styles (shared with the About window, as in RizzExplorer) -->
    <Style Selector="TextBlock.pageTitle"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="11" /><Setter Property="Opacity" Value="0.65" /></Style>
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Section header bar, as in property panes -->
    <Style Selector="Border.section">
      <Setter Property="Background" Value="{DynamicResource HeaderBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0,1" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.section > TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SectionTextBrush}" />
    </Style>

    <!-- Property grid rows: label cell + editor cell -->
    <Style Selector="Border.prop-label">
      <Setter Property="Background" Value="{DynamicResource PropLabelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Border.prop-label > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prop-value">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Border.prop-value TextBox, Border.prop-value ComboBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.prop-value TextBox">
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.prop-value CheckBox">
      <Setter Property="Margin" Value="8,0" />
    </Style>

    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolHoverBorderBrush}" />
    </Style>
    <Style Selector="Button.tool Path">
      <Setter Property="Fill" Value="{DynamicResource ToolIconBrush}" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="22" />
    </Style>

    <Style Selector="DataGrid">
      <Setter Property="GridLinesVisibility" Value="All" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="RowHeight" Value="24" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource ColumnHeaderBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DataGridCell ComboBox">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
  </Application.Styles>
</Application>
