<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RizzServer.Core\RizzServer.Core.csproj" />
    <ProjectReference Include="..\RizzServer.Drivers\RizzServer.Drivers.csproj" />
    <ProjectReference Include="..\RizzServer.Server\RizzServer.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RizzServer</AssemblyName>
    <RootNamespace>RizzServer.App</RootNamespace>
    <Description>OPC UA gateway for Modbus, RS-232, MQTT, OPC DA and OPC UA sources</Description>
  </PropertyGroup>

</Project>
