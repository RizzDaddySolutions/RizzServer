<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RizzServer.App.ViewModels"
        xmlns:v="using:RizzServer.App.Views"
        xmlns:local="using:RizzServer.App"
        x:Class="RizzServer.App.Views.MainWindow"
        Icon="/Assets/icon.ico"
        Title="{Binding App.WindowTitle}" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
  </Window.KeyBindings>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ProjectNode"><v:ProjectView /></DataTemplate>
    <DataTemplate DataType="vm:ConnectivityNode"><v:ConnectivityView /></DataTemplate>
    <DataTemplate DataType="vm:ChannelNode"><v:ChannelView /></DataTemplate>
    <DataTemplate DataType="vm:DeviceNode"><v:DeviceView /></DataTemplate>
    <DataTemplate DataType="vm:ServerNode"><v:ServerView /></DataTemplate>
    <DataTemplate DataType="vm:QuickClientNode"><v:QuickClientView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}">
      <MenuItem Header="_File">
        <MenuItem Header="_Save Project" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <Separator />
        <MenuItem Header="Connect to _Service…" Command="{Binding ConnectCommand}" />
        <MenuItem Header="_Reload from Service" Command="{Binding ReloadCommand}" />
        <MenuItem Header="_Disconnect from Service" Command="{Binding DisconnectCommand}" />
        <Separator />
        <MenuItem Header="_Import Tags from CSV…" Command="{Binding ImportTagsCommand}" />
        <MenuItem Header="E_xport Tags to CSV…" Command="{Binding ExportTagsCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitAppCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="New _Channel…" Command="{Binding AddChannelCommand}" />
        <MenuItem Header="New _Device…" Command="{Binding AddDeviceCommand}" />
        <MenuItem Header="New _Tag" Command="{Binding AddTagCommand}" />
        <Separator />
        <MenuItem Header="_Rename…" InputGesture="F2" Command="{Binding RenameCommand}" />
        <MenuItem Header="_Delete Selected" Command="{Binding DeleteCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Event Log" Command="{Binding ToggleLogCommand}" ToggleType="CheckBox"
                  IsChecked="{Binding LogVisible, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="Theme: System" Command="{Binding SetThemeCommand}" CommandParameter="System"
                  ToggleType="Radio" GroupName="Theme" IsChecked="{Binding IsThemeSystem, Mode=OneWay}" />
        <MenuItem Header="Theme: Light" Command="{Binding SetThemeCommand}" CommandParameter="Light"
                  ToggleType="Radio" GroupName="Theme" IsChecked="{Binding IsThemeLight, Mode=OneWay}" />
        <MenuItem Header="Theme: Dark" Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                  ToggleType="Radio" GroupName="Theme" IsChecked="{Binding IsThemeDark, Mode=OneWay}" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Protocol Designer…" Command="{Binding OpenDesignerCommand}" />
      </MenuItem>
      <MenuItem Header="_Runtime">
        <MenuItem Header="_Start" Command="{Binding App.StartCommand}" />
        <MenuItem Header="S_top" Command="{Binding App.StopCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About RizzServer" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0,1,0,1" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save project (Ctrl+S)">
          <Path Data="{DynamicResource SaveIcon}" />
        </Button>
        <Border Width="1" Margin="4,2" Background="{DynamicResource LineBrush}" />
        <Button Classes="tool" Command="{Binding AddChannelCommand}" ToolTip.Tip="New channel">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{DynamicResource PlusIcon}" /><TextBlock Text="Channel" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding AddDeviceCommand}" ToolTip.Tip="New device on the selected channel">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{DynamicResource PlusIcon}" /><TextBlock Text="Device" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding AddTagCommand}" ToolTip.Tip="New tag on the selected device">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{DynamicResource PlusIcon}" /><TextBlock Text="Tag" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete selected channel or device">
          <Path Data="{DynamicResource CrossIcon}" />
        </Button>
        <Border Width="1" Margin="4,2" Background="{DynamicResource LineBrush}" />
        <Button Classes="tool" Command="{Binding App.StartCommand}" ToolTip.Tip="Start runtime">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{DynamicResource PlayIcon}" Fill="SeaGreen" /><TextBlock Text="Start Runtime" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding App.StopCommand}" ToolTip.Tip="Stop runtime">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{DynamicResource StopIcon}" Fill="Firebrick" /><TextBlock Text="Stop Runtime" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
        <TextBlock Text="{Binding App.Status}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding App.EndpointUrl}" Margin="12,0,24,0" Foreground="{DynamicResource MutedBrush}" />
        <TextBlock Grid.Column="2" Text="● unsaved changes" Margin="0,0,24,0" Foreground="#B7791F" IsVisible="{Binding App.IsDirty}"
                   ToolTip.Tip="This copy differs from the service. Save (Ctrl+S) pushes it." />
        <Border Grid.Column="3" Classes="chip" IsVisible="{Binding App.IsRemote}" Margin="0,0,16,0">
          <TextBlock Text="{Binding App.ConnectionText}" />
        </Border>
        <TextBlock Grid.Column="4" Margin="0,0,24,0">
          <Run Text="Active tags: " /><Run Text="{Binding App.RunningTags.Count, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="5" Text="{Binding App.RuntimeText}" FontWeight="SemiBold" />
      </Grid>
    </Border>

    <!-- Main area: tree | detail, event log below -->
    <Grid x:Name="MainArea" RowDefinitions="*,4,190">
      <Grid x:Name="TopArea" Grid.Row="0" ColumnDefinitions="260,Auto,*">
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource PanelBrush}">
          <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="{DynamicResource PanelBrush}"
                    local:ContextMenuBehavior.SelectOnRightClick="True">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:NavNode" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                  <StackPanel.ContextMenu>
                    <ContextMenu ItemsSource="{Binding MenuEntries}">
                      <ContextMenu.Styles>
                        <Style Selector="MenuItem">
                          <Setter Property="Header" Value="{Binding Header}" />
                          <Setter Property="Command" Value="{Binding Command}" />
                        </Style>
                      </ContextMenu.Styles>
                    </ContextMenu>
                  </StackPanel.ContextMenu>
                  <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TreeIconFillBrush}" Stroke="{DynamicResource TreeIconStrokeBrush}"
                        StrokeThickness="1" IsVisible="{Binding !ShowStateDot}" />
                  <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" IsVisible="{Binding ShowStateDot}"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>
        <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="4" Background="{DynamicResource ChromeBrush}" />
        <ContentControl Grid.Column="2" Content="{Binding SelectedNode}" Background="{DynamicResource PanelBrush}" />
      </Grid>

      <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                    Background="{DynamicResource ChromeBrush}" />

      <!-- Event log -->
      <Grid x:Name="LogPanel" Grid.Row="2" RowDefinitions="Auto,*" ClipToBounds="True">
        <Border Classes="section"><TextBlock Text="Event Log" /></Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding App.Logs.Entries}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" x:Name="LogGrid"
                  SelectedItem="{Binding SelectedLog, Mode=TwoWay}" local:ContextMenuBehavior.SelectOnRightClick="True">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copy Event" Command="{Binding CopyLogEntryCommand}" />
              <MenuItem Header="-" />
              <MenuItem Header="Clear Log" Command="{Binding ClearLogCommand}" />
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="28">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
            <DataGridTextColumn Header="Time" Binding="{Binding Clock}" Width="100" />
            <DataGridTextColumn Header="Source" Binding="{Binding Category}" Width="180" />
            <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
