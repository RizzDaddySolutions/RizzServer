<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RizzServer.App.ViewModels"
        xmlns:v="using:RizzServer.App.Views"
        x:Class="RizzServer.App.Views.MainWindow"
        Title="RizzServer — OPC UA Gateway" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
  </Window.KeyBindings>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:ProjectNode"><v:ProjectView /></DataTemplate>
    <DataTemplate DataType="vm:ConnectivityNode"><v:ConnectivityView /></DataTemplate>
    <DataTemplate DataType="vm:ConnectionNode"><v:ConnectionView /></DataTemplate>
    <DataTemplate DataType="vm:ServerNode"><v:ServerView /></DataTemplate>
    <DataTemplate DataType="vm:QuickClientNode"><v:QuickClientView /></DataTemplate>
  </Window.DataTemplates>

  <DockPanel>
    <!-- Menu bar -->
    <Menu DockPanel.Dock="Top" Background="White">
      <MenuItem Header="_File">
        <MenuItem Header="_Save Project" InputGesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitAppCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="New _Channel" Command="{Binding AddConnectionCommand}" />
        <MenuItem Header="New _Tag" Command="{Binding AddTagCommand}" />
        <Separator />
        <MenuItem Header="_Delete Channel" Command="{Binding DeleteConnectionCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Event Log" Command="{Binding ToggleLogCommand}" />
      </MenuItem>
      <MenuItem Header="_Runtime">
        <MenuItem Header="_Start" Command="{Binding App.StartCommand}" />
        <MenuItem Header="S_top" Command="{Binding App.StopCommand}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About RizzServer" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,1" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" Command="{Binding SaveCommand}" ToolTip.Tip="Save project (Ctrl+S)">
          <Path Data="{StaticResource SaveIcon}" />
        </Button>
        <Border Width="1" Margin="4,2" Background="{StaticResource LineBrush}" />
        <Button Classes="tool" Command="{Binding AddConnectionCommand}" ToolTip.Tip="New channel">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{StaticResource PlusIcon}" /><TextBlock Text="Channel" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding AddTagCommand}" ToolTip.Tip="New tag in selected channel">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{StaticResource PlusIcon}" /><TextBlock Text="Tag" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding DeleteConnectionCommand}" ToolTip.Tip="Delete selected channel">
          <Path Data="{StaticResource CrossIcon}" />
        </Button>
        <Border Width="1" Margin="4,2" Background="{StaticResource LineBrush}" />
        <Button Classes="tool" Command="{Binding App.StartCommand}" ToolTip.Tip="Start runtime">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{StaticResource PlayIcon}" Fill="SeaGreen" /><TextBlock Text="Start Runtime" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="tool" Command="{Binding App.StopCommand}" ToolTip.Tip="Stop runtime">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Path Data="{StaticResource StopIcon}" Fill="Firebrick" /><TextBlock Text="Stop Runtime" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0" Padding="8,3">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding App.Status}" />
        <TextBlock Grid.Column="1" Text="{Binding App.EndpointUrl}" Margin="0,0,24,0" Foreground="{StaticResource MutedBrush}" />
        <TextBlock Grid.Column="2" Margin="0,0,24,0">
          <Run Text="Active tags: " /><Run Text="{Binding App.RunningTags.Count, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Grid.Column="3" Text="{Binding App.RuntimeText}" FontWeight="SemiBold" />
      </Grid>
    </Border>

    <!-- Main area: tree | detail, event log below -->
    <Grid RowDefinitions="*,Auto,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="260,Auto,*">
        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Background="White">
          <TreeView ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Background="White">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:NavNode" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Data="{Binding Icon}" Width="14" Height="14" Stretch="Uniform" Fill="#B7C7DD" Stroke="#33557F"
                        StrokeThickness="1" IsVisible="{Binding !ShowStateDot}" />
                  <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}" IsVisible="{Binding ShowStateDot}"
                           VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Border>
        <GridSplitter Grid.Column="1" Width="4" Background="{StaticResource ChromeBrush}" />
        <ContentControl Grid.Column="2" Content="{Binding SelectedNode}" Background="White" />
      </Grid>

      <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" IsVisible="{Binding LogVisible}"
                    Background="{StaticResource ChromeBrush}" />

      <!-- Event log -->
      <Grid Grid.Row="2" Height="190" RowDefinitions="Auto,*" IsVisible="{Binding LogVisible}">
        <Border Classes="section"><TextBlock Text="Event Log" /></Border>
        <DataGrid Grid.Row="1" ItemsSource="{Binding App.Logs.Entries}" AutoGenerateColumns="False"
                  IsReadOnly="True" HeadersVisibility="Column" x:Name="LogGrid">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="" Width="28">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Glyph}" Foreground="{Binding Color}" HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="100" />
            <DataGridTextColumn Header="Time" Binding="{Binding Clock}" Width="100" />
            <DataGridTextColumn Header="Source" Binding="{Binding Category}" Width="180" />
            <DataGridTextColumn Header="Event" Binding="{Binding Message}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
