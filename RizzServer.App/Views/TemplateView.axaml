<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RizzServer.App"
             x:Class="RizzServer.App.Views.TemplateView">
  <Grid RowDefinitions="Auto,Auto,Auto,*" IsEnabled="{Binding App.IsEditable}">
    <Border Grid.Row="0" Classes="section"><TextBlock><Run Text="Template — " /><Run Text="{Binding Title}" /></TextBlock></Border>

    <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Name" /></Border>
          <Border Grid.Column="1" Classes="prop-value"><TextBox Text="{Binding Config.Name}" /></Border>
        </Grid>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Description" /></Border>
          <Border Grid.Column="1" Classes="prop-value"><TextBox Text="{Binding Config.Description}" /></Border>
        </Grid>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Driver" /></Border>
          <Border Grid.Column="1" Classes="prop-value">
            <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </Border>
        </Grid>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Scan rate (ms)" /></Border>
          <Border Grid.Column="1" Classes="prop-value"><TextBox Text="{Binding Config.ScanRateMs}" /></Border>
        </Grid>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Parameters (name=default, one per line)" TextWrapping="Wrap" /></Border>
          <Border Grid.Column="1" Classes="prop-value">
            <TextBox Text="{Binding ParametersText}" AcceptsReturn="True" MinHeight="60" FontFamily="Consolas,Menlo,monospace" />
          </Border>
        </Grid>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Device settings (key=value, may use {parameters})" TextWrapping="Wrap" /></Border>
          <Border Grid.Column="1" Classes="prop-value">
            <StackPanel>
              <TextBox Text="{Binding SettingsText}" AcceptsReturn="True" MinHeight="60" FontFamily="Consolas,Menlo,monospace" />
              <TextBlock Text="{Binding DeviceSettingKeys, StringFormat='Keys: {0}'}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Margin="8,4" Text="{Binding Problems}" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="{Binding Problems.Length}" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="section">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="Tags" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" Text="{Binding AddressHint, StringFormat='Address: {0}'}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Classes="tool" Command="{Binding AddTagCommand}"><StackPanel Orientation="Horizontal" Spacing="4"><Path Data="{DynamicResource PlusIcon}" /><TextBlock Text="New Tag" /></StackPanel></Button>
          <Button Classes="tool" Command="{Binding RemoveTagCommand}"><StackPanel Orientation="Horizontal" Spacing="4"><Path Data="{DynamicResource CrossIcon}" /><TextBlock Text="Delete" /></StackPanel></Button>
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Config.Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
              AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tag name" Binding="{Binding Name}" Width="150" />
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" MinWidth="150" />
        <DataGridTemplateColumn Header="Data type" Width="115">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.DataTypes}" SelectedItem="{Binding DataType}" /></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Client access" Width="115">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate><ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Accesses}" SelectedItem="{Binding Access}" /></DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Units" Binding="{Binding Units}" Width="100" />
        <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="100" />
        <DataGridTextColumn Header="Offset" Binding="{Binding Offset}" Width="100" />
        <DataGridTextColumn Header="Min" Binding="{Binding EuMin}" Width="100" />
        <DataGridTextColumn Header="Max" Binding="{Binding EuMax}" Width="100" />
        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="160" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
