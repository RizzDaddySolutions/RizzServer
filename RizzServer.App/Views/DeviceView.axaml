<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RizzServer.App.Views.DeviceView">
  <Grid RowDefinitions="Auto,Auto,Auto,*" IsEnabled="{Binding App.IsEditable}">

    <Border Grid.Row="0" Classes="section">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock>
          <Run Text="Device Properties — " /><Run Text="{Binding ChannelName}" /><Run Text="." /><Run Text="{Binding Title}" />
        </TextBlock>
        <TextBlock Grid.Column="1" Text="{Binding StateText}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Name" /></Border>
          <Border Grid.Column="1" Classes="prop-value"><TextBox Text="{Binding Config.Name}" /></Border>
        </Grid>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Scan rate (ms)" /></Border>
          <Border Grid.Column="1" Classes="prop-value"><TextBox Text="{Binding Config.ScanRateMs}" /></Border>
        </Grid>
        <Grid ColumnDefinitions="220,*">
          <Border Classes="prop-label"><TextBlock Text="Enabled" /></Border>
          <Border Grid.Column="1" Classes="prop-value"><CheckBox IsChecked="{Binding Config.Enabled}" VerticalAlignment="Center" /></Border>
        </Grid>

        <Border Classes="section" IsVisible="{Binding HasSettings}"><TextBlock Text="Device settings" /></Border>
        <ItemsControl ItemsSource="{Binding Settings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="220,*">
                <Border Classes="prop-label"><TextBlock Text="{Binding Label}" /></Border>
                <Border Grid.Column="1" Classes="prop-value">
                  <Panel>
                    <TextBox Text="{Binding Value}" PasswordChar="{Binding PasswordChar}" IsVisible="{Binding IsFreeText}" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" IsVisible="{Binding HasOptions}" />
                  </Panel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="section">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="Tags" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" Text="{Binding AddressHint, StringFormat='Address: {0}'}" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <Button Classes="tool" Command="{Binding ImportTagsCommand}" ToolTip.Tip="Add or update tags from a CSV file">
            <TextBlock Text="Import CSV…" />
          </Button>
          <Button Classes="tool" Command="{Binding ExportTagsCommand}" ToolTip.Tip="Save this device's tags as a CSV file">
            <TextBlock Text="Export CSV…" />
          </Button>
          <Border Width="1" Margin="2,2" Background="{DynamicResource LineBrush}" />
          <Button Classes="tool" Command="{Binding AddTagCommand}" ToolTip.Tip="New tag">
            <StackPanel Orientation="Horizontal" Spacing="4"><Path Data="{DynamicResource PlusIcon}" /><TextBlock Text="New Tag" /></StackPanel>
          </Button>
          <Button Classes="tool" Command="{Binding RemoveTagCommand}" ToolTip.Tip="Delete selected tag">
            <StackPanel Orientation="Horizontal" Spacing="4"><Path Data="{DynamicResource CrossIcon}" /><TextBlock Text="Delete" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <DataGrid Grid.Row="3" ItemsSource="{Binding Config.Tags}" SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
              AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Tag name" Binding="{Binding Name}" Width="180" />
        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*" />
        <DataGridTemplateColumn Header="Data type" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.DataTypes}" SelectedItem="{Binding DataType}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Client access" Width="130">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.Accesses}" SelectedItem="{Binding Access}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
