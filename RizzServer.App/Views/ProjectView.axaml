<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RizzServer.App.Views.ProjectView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="section"><TextBlock Text="Project Properties" /></Border>
    <StackPanel>
      <Grid ColumnDefinitions="200,*">
        <Border Classes="prop-label"><TextBlock Text="Project file" /></Border>
        <Border Grid.Column="1" Classes="prop-value"><TextBlock Text="{Binding ProjectPath}" Margin="8,5" /></Border>
      </Grid>
      <Grid ColumnDefinitions="200,*">
        <Border Classes="prop-label"><TextBlock Text="Channels" /></Border>
        <Border Grid.Column="1" Classes="prop-value"><TextBlock Text="{Binding App.Config.Channels.Count}" Margin="8,5" /></Border>
      </Grid>
      <Grid ColumnDefinitions="200,*">
        <Border Classes="prop-label"><TextBlock Text="Devices" /></Border>
        <Border Grid.Column="1" Classes="prop-value"><TextBlock Text="{Binding DeviceCount}" Margin="8,5" /></Border>
      </Grid>
      <Grid ColumnDefinitions="200,*">
        <Border Classes="prop-label"><TextBlock Text="Tags" /></Border>
        <Border Grid.Column="1" Classes="prop-value"><TextBlock Text="{Binding TagCount}" Margin="8,5" /></Border>
      </Grid>
      <Grid ColumnDefinitions="200,*">
        <Border Classes="prop-label"><TextBlock Text="OPC UA endpoint" /></Border>
        <Border Grid.Column="1" Classes="prop-value">
          <TextBlock Text="{Binding App.EndpointUrl, FallbackValue=(runtime stopped)}" Margin="8,5" />
        </Border>
      </Grid>
      <Grid ColumnDefinitions="200,*">
        <Border Classes="prop-label"><TextBlock Text="Runtime" /></Border>
        <Border Grid.Column="1" Classes="prop-value"><TextBlock Text="{Binding App.Status}" Margin="8,5" /></Border>
      </Grid>
      <TextBlock Margin="12,16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                 Text="Channels hold the communication settings (driver, COM port, broker…). Each channel contains devices, and each device holds tags. Use Start Runtime to publish all enabled devices over OPC UA as Channel.Device.Tag." />
    </StackPanel>
  </DockPanel>
</UserControl>
