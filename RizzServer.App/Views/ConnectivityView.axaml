<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RizzServer.App.Views.ConnectivityView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="section"><TextBlock Text="Connectivity — Channels" /></Border>
    <TextBlock DockPanel.Dock="Bottom" Margin="8" Foreground="{DynamicResource MutedBrush}"
               Text="Double-click a channel to open it. Use Edit ▸ New Channel to add one; a channel holds one or more devices, and devices hold tags." />
    <DataGrid ItemsSource="{Binding Channels}" SelectedItem="{Binding Selected, Mode=TwoWay}"
              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
              DoubleTapped="OnRowDoubleTapped" BorderThickness="0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Channel name" Binding="{Binding Name}" Width="200" />
        <DataGridTextColumn Header="Driver" Binding="{Binding DriverType}" Width="140" />
        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90" />
        <DataGridTextColumn Header="Devices" Binding="{Binding Devices.Count}" Width="100" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
