<Page x:Class="RizzServer.App.Pages.LiveDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Live Data">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBlock Text="Live Data" FontTypography="Title" Margin="0,0,0,12" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding App.RunningTags}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Node" Binding="{Binding NodePath}" Width="*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="160" />
                <DataGridTemplateColumn Header="Quality" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Quality}" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#E5534B" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Quality}" Value="Good">
                                                <Setter Property="Foreground" Value="#57AB5A" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Quality}" Value="Uncertain">
                                                <Setter Property="Foreground" Value="#C69026" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Type" Binding="{Binding Config.DataType}" Width="90" />
                <DataGridTextColumn Header="Access" Binding="{Binding Config.Access}" Width="100" />
                <DataGridTextColumn Header="Updated (UTC)" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <ui:TextBox Width="240" PlaceholderText="Value to write" Margin="0,0,8,0"
                            Text="{Binding WriteText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Content="Write to selected tag" Icon="{ui:SymbolIcon Edit24}"
                           Command="{Binding WriteCommand}" />
            </StackPanel>
            <ui:TextBlock Text="{Binding Message}" Margin="0,8,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
